---
const year = new Date().getFullYear();

const serviceLinks = [
  { label: 'Ad Creative', href: '/services/ad-creative' },
  { label: 'Brand Identity', href: '/services/brand-identity' },
  { label: 'Web Design', href: '/services/web-digital' },
  { label: 'AI-Enhanced Creative', href: '/services/ai-enhanced-creative' },
  { label: 'All services', href: '/services' },
];

const studioLinks = [
  { label: 'Work', href: '/work' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];

// TODO: replace with real profile URLs
const social = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/company/dunn-creative' },
  { label: 'Instagram', href: 'https://www.instagram.com/dunncreative' },
];
---

<footer class="border-t border-line">
  <div class="container section-sm">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      <!-- Brand -->
      <div>
        <a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
          <span class="inline-block h-2.5 w-2.5 rounded-full bg-accent"></span>
          Dunn Creative
        </a>
        <p class="mt-4 max-w-xs text-sm text-ink-dim">
          An independent studio building brands, websites, and content with an
          AI-accelerated workflow.
        </p>
        <div class="mt-5 flex gap-4">
          {social.map((s) => (
            <a
              href={s.href}
              rel="noopener noreferrer"
              target="_blank"
              class="text-sm text-ink-soft transition-colors hover:text-accent"
            >
              {s.label}
            </a>
          ))}
        </div>
      </div>

      <!-- Services -->
      <div>
        <h2 class="text-sm uppercase tracking-wide text-ink-dim">Services</h2>
        <ul class="mt-4 flex flex-col gap-2">
          {serviceLinks.map((l) => (
            <li>
              <a href={l.href} class="text-sm text-ink-soft transition-colors hover:text-accent">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Studio -->
      <div>
        <h2 class="text-sm uppercase tracking-wide text-ink-dim">Studio</h2>
        <ul class="mt-4 flex flex-col gap-2">
          {studioLinks.map((l) => (
            <li>
              <a href={l.href} class="text-sm text-ink-soft transition-colors hover:text-accent">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- CTA -->
      <div>
        <h2 class="text-lg">Have a project in mind?</h2>
        <p class="mt-3 text-sm text-ink-dim">
          Tell us what you're building. We reply within one business day.
        </p>
        <a href="/contact" class="btn btn-primary mt-5">Start a project</a>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-center justify-between gap-3 border-t border-line pt-8 text-sm text-ink-dim sm:flex-row">
      <p>© {year} Dunn Creative. All rights reserved.</p>
      <p>Built with Astro · Hosted on Hostinger</p>
    </div>
  </div>
</footer>
