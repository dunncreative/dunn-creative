---
import PageLayout from '../layouts/PageLayout.astro';

const values = [
  {
    title: 'Strategy first',
    body: 'We never design in a vacuum. Every choice traces back to a goal.',
  },
  {
    title: 'Senior craft',
    body: 'No handoffs to juniors. The people you meet are the people who build.',
  },
  {
    title: 'Modern speed',
    body: 'AI handles the busywork so we move faster without cutting quality.',
  },
  {
    title: 'Real partnership',
    body: 'Clear communication, honest timelines, and work we both stand behind.',
  },
];
---

<PageLayout
  title="About — Dunn Creative"
  description="An independent creative studio pairing senior craft with an AI-accelerated workflow."
  heroLabel="About"
  heroTitle="A small studio with a modern engine."
  heroSubtitle="We're built for founders and teams who want studio-grade work without studio-grade timelines."
>
  <!-- Intro -->
  <section class="section-sm">
    <div class="container-narrow prose fade-up">
      <p>
        Dunn Creative is an independent studio working at the intersection of
        brand, web, and content. We started with a simple conviction: the old
        agency model is slow, expensive, and bloated — and most of that bloat
        has nothing to do with the quality of the work.
      </p>
      <p>
        So we built something leaner. Senior people doing the actual work, paired
        with an AI-accelerated workflow that strips out the busywork. The result
        is a studio that ships faster, charges fairly, and still cares deeply
        about craft.
      </p>
    </div>
  </section>

  <!-- Values -->
  <section class="section-sm border-t border-line">
    <div class="container">
      <h2 class="fade-up text-2xl">What we believe</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {values.map((v) => (
          <div class="card-base fade-up p-6">
            <h3 class="text-lg">{v.title}</h3>
            <p class="mt-2 text-sm text-ink-soft">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Founder -->
  <section class="section-sm border-t border-line">
    <div class="container grid gap-10 md:grid-cols-[300px_1fr] md:items-center">
      <img
        src="/images/about/christopher-dunn.jpg"
        alt="Christopher Dunn, Owner and Creative Director of Dunn Creative"
        width="800"
        height="800"
        loading="lazy"
        class="fade-up aspect-square w-full rounded-card border border-line bg-surface-2 object-cover"
      />
      <div class="fade-up">
        <span class="tag tag-accent">Led by experience</span>
        <h2 class="mt-5 text-2xl">Built for brands that want better creative.</h2>
        <div class="mt-4 prose">
          <p>
            Dunn Creative is led by Christopher Dunn, a designer and strategist
            whose background spans agency work, creative leadership, and digital
            brand building. Before launching the studio, he held design and
            creative leadership roles at Teton Gravity Research, contributing to
            the company's brand, digital platforms, partnerships, and marketing
            growth.
          </p>
          <p>
            That mix of brand thinking, digital execution, and creative
            direction shapes the studio's approach today: thoughtful work, high
            standards, and a clear focus on helping brands elevate both presence
            and performance.
          </p>
        </div>
        <p class="mt-6 text-sm">
          <span class="font-semibold text-ink">Christopher Dunn</span>
          <span class="text-ink-dim"> · Owner &amp; Creative Director</span>
        </p>
      </div>
    </div>
  </section>

  <!-- Location -->
  <section class="section-sm border-t border-line">
    <div class="container-narrow fade-up text-center">
      <p class="text-ink-soft">
        Based remotely · working with clients everywhere. We reply within one
        business day.
      </p>
      <a href="/start" class="btn btn-primary mt-6">Start a project</a>
    </div>
  </section>
</PageLayout>
