---
// Public placeholder for the dunncreative.net dev domain.
// The real (in-progress) homepage lives at /home — reachable by direct link only.
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dunn Creative</title>
    <meta name="description" content="Dunn Creative development website." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />
  </head>
  <body>
    <main class="dev-screen">
      <div class="dev-glow" aria-hidden="true"></div>
      <div class="dev-card">
        <span class="dev-mark">
          <span class="dev-dot" aria-hidden="true"></span>
          Dunn Creative
        </span>
        <span class="dev-label">Development Website</span>
        <p class="dev-text">
          Visit our official website at
          <a href="https://dunncreative.com">dunncreative.com</a>
        </p>
      </div>
    </main>

    <style>
      .dev-screen {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100svh;
        overflow: hidden;
        padding: var(--space-6);
      }
      .dev-glow {
        position: absolute;
        left: 50%;
        top: 50%;
        width: min(680px, 90vw);
        height: min(680px, 90vw);
        transform: translate(-50%, -50%);
        background: radial-gradient(
          circle,
          rgba(26, 166, 170, 0.16) 0%,
          rgba(26, 166, 170, 0) 70%
        );
        pointer-events: none;
      }
      .dev-card {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: var(--space-4);
      }
      .dev-mark {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        font-size: clamp(1.6rem, 5vw, 2.4rem);
        font-weight: 600;
        letter-spacing: -0.03em;
        color: var(--color-ink);
      }
      .dev-dot {
        width: 0.7rem;
        height: 0.7rem;
        border-radius: var(--radius-full);
        background: var(--color-accent);
        box-shadow: 0 0 18px rgba(26, 166, 170, 0.7);
      }
      .dev-label {
        font-size: var(--text-xs);
        text-transform: uppercase;
        letter-spacing: 0.28em;
        color: var(--color-ink-dim);
      }
      .dev-text {
        margin: 0;
        margin-top: var(--space-2);
        max-width: 32ch;
        color: var(--color-ink-soft);
        line-height: var(--leading-normal);
      }
      .dev-text a {
        color: var(--color-accent-soft);
        text-decoration: none;
        border-bottom: 1px solid color-mix(in srgb, var(--color-accent) 45%, transparent);
        transition: color var(--dur-fast) var(--ease-out);
      }
      .dev-text a:hover {
        color: var(--color-accent);
      }
    </style>
  </body>
</html>
