---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import ProjectCard from '../../components/cards/ProjectCard.astro';

const work = (await getCollection('work')).sort(
  (a, b) => a.data.order - b.data.order
);

const categories = [
  'All',
  ...Array.from(new Set(work.flatMap((p) => p.data.categories))).sort(),
];
---

<PageLayout
  title="Work — Dunn Creative"
  description="Selected projects across brand identity, web, content, and presentations."
  heroLabel="Portfolio"
  heroTitle="Work that earns its keep."
  heroSubtitle="A look at recent projects — and the problems they solved."
>
  <section class="section-sm">
    <div class="container">
      <!-- Filters -->
      <div class="flex flex-wrap gap-2" role="group" aria-label="Filter projects by category">
        {categories.map((cat) => (
          <button
            class="filter-btn tag"
            data-category={cat}
            aria-pressed={cat === 'All' ? 'true' : 'false'}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Grid -->
      <div id="work-grid" class="mt-10 grid gap-6 md:grid-cols-2">
        {work.map((project) => (
          <div class="work-item" data-categories={project.data.categories.join('|')}>
            <ProjectCard project={project} />
          </div>
        ))}
      </div>

      <!-- Empty state -->
      <p id="work-empty" class="hidden py-16 text-center text-ink-dim">
        No projects in this category yet — check back soon.
      </p>
    </div>
  </section>
</PageLayout>

<script>
  const setup = () => {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const items = document.querySelectorAll<HTMLElement>('.work-item');
    const empty = document.getElementById('work-empty');

    const apply = (category: string) => {
      let visible = 0;
      items.forEach((item) => {
        const cats = (item.dataset.categories ?? '').split('|');
        const show = category === 'All' || cats.includes(category);
        item.classList.toggle('hidden', !show);
        if (show) visible++;
      });
      empty?.classList.toggle('hidden', visible > 0);
    };

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => b.setAttribute('aria-pressed', 'false'));
        btn.setAttribute('aria-pressed', 'true');
        apply(btn.dataset.category ?? 'All');
      });
    });
  };
  setup();
  document.addEventListener('astro:after-swap', setup);
</script>

<style>
  .filter-btn {
    cursor: pointer;
  }
  .filter-btn[aria-pressed='true'] {
    border-color: color-mix(in srgb, var(--color-accent) 50%, transparent);
    background: color-mix(in srgb, var(--color-accent) 14%, transparent);
    color: var(--color-accent-soft);
  }
</style>
