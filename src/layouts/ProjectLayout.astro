---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  client: string;
  year: number;
  categories?: string[];
  heroImage: string;
  gallery?: string[];
  challenge: string;
  outcome: string;
  tags?: string[];
  description: string;
}

const {
  title,
  client,
  year,
  categories = [],
  heroImage,
  gallery = [],
  challenge,
  outcome,
  tags = [],
  description,
} = Astro.props;
---

<BaseLayout title={`${title} — Dunn Creative`} description={description} image={heroImage}>
  <!-- Hero -->
  <section data-theme="dark" class="section-sm bg-bg text-ink">
    <div class="container">
      <div class="flex flex-wrap items-center gap-3 fade-up">
        {categories.map((c) => <span class="tag">{c}</span>)}
      </div>
      <h1 class="fade-up mt-5 text-4xl gradient-text">{title}</h1>
      <p class="fade-up mt-3 text-lg text-ink-soft">
        {client} · {year}
      </p>
    </div>
  </section>

  <!-- Full-bleed hero image -->
  <div class="container">
    <img
      src={heroImage}
      alt={`${title} — project hero image for ${client}`}
      width="1200"
      height="800"
      class="fade-up w-full rounded-card border border-line object-cover"
    />
  </div>

  <!-- Challenge / Outcome -->
  <section class="section-sm">
    <div class="container grid gap-6 md:grid-cols-2">
      <div class="card-base fade-up p-8">
        <h2 class="text-sm uppercase tracking-wide text-ink-dim">The challenge</h2>
        <p class="mt-3 text-ink-soft">{challenge}</p>
      </div>
      <div class="card-base fade-up border-accent p-8">
        <h2 class="text-sm uppercase tracking-wide text-accent">The outcome</h2>
        <p class="mt-3 text-ink-soft">{outcome}</p>
      </div>
    </div>
  </section>

  <!-- Body -->
  <section class="section-sm">
    <div class="container-narrow prose fade-up">
      <slot />
    </div>
  </section>

  <!-- Gallery -->
  {gallery.length > 0 && (
    <section class="section-sm">
      <div class="container columns-1 gap-6 md:columns-2 [&>img]:mb-6">
        {gallery.map((src, i) => (
          <img
            src={src}
            alt={`${title} gallery image ${i + 1}`}
            width="800"
            height="600"
            class="fade-up w-full rounded-card border border-line"
          />
        ))}
      </div>
    </section>
  )}

  <!-- Tags -->
  {tags.length > 0 && (
    <div class="container flex flex-wrap gap-2">
      {tags.map((t) => <span class="tag">{t}</span>)}
    </div>
  )}

  <!-- Footer bar -->
  <section data-theme="dark" class="section-sm mt-16 bg-bg text-ink">
    <div class="container flex flex-col items-center justify-between gap-6 sm:flex-row">
      <a href="/work" class="btn btn-ghost">← Back to all work</a>
      <a href="/start" class="btn btn-primary">Start a project like this</a>
    </div>
  </section>
</BaseLayout>
