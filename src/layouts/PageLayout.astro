---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title?: string;
  description?: string;
  heroLabel?: string;
  heroTitle: string;
  heroSubtitle?: string;
  heroCentered?: boolean;
}

const {
  title,
  description,
  heroLabel,
  heroTitle,
  heroSubtitle,
  heroCentered = false,
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <section class="section-sm border-b border-line">
    <div class={`container ${heroCentered ? 'text-center' : ''}`}>
      <div class={heroCentered ? 'mx-auto max-w-narrow' : 'max-w-narrow'}>
        {heroLabel && (
          <span class="tag tag-accent fade-up">{heroLabel}</span>
        )}
        <h1 class="fade-up mt-5 text-4xl gradient-text">{heroTitle}</h1>
        {heroSubtitle && (
          <p class="fade-up mt-5 text-lg text-ink-soft">{heroSubtitle}</p>
        )}
      </div>
    </div>
  </section>
  <slot />
</BaseLayout>
